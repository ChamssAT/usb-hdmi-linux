[Desktop Entry]
Type=Application
Name=Écran USB/HDMI
GenericName=Mode d'affichage de l'écran externe
Comment=Choisir entre écran étendu, miroir ou éteint
# Ajustez le chemin si vous avez cloné le dépôt ailleurs que dans ~/Bureau
Exec=sh -c '"$HOME/Bureau/usb-display/choisir-mode-ecran.sh"'
Icon=preferences-desktop-display
Terminal=false
StartupNotify=false
Categories=Settings;HardwareSettings;
Keywords=écran;hdmi;usb;miroir;extend;affichage;
